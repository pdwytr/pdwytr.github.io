    classDef branch fill:#fef9c3,stroke:#ca8a04,stroke-width:2px,color:#713f12
    classDef context fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef pr fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d
    classDef ci fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef human fill:#fce7f3,stroke:#db2777,stroke-width:2px,color:#831843
    classDef fail fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d
    classDef node fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px,color:#312e81
